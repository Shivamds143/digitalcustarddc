# Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=digital_custard

# Admin Authentication
ADMIN_PASSWORD=
ADMIN_SECRET=

# Active Email Provider Selection: "gmail" (for development/testing) or "milesweb" (for production)
EMAIL_PROVIDER=gmail

# -------------------------------------------------------------
# 1. DEVELOPMENT TESTING: Gmail SMTP Configuration
# -------------------------------------------------------------
# Generate a 16-character App Password in Google Account:
# Security > 2-Step Verification > App passwords
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=
GMAIL_ADMIN_EMAIL=your_email@gmail.com

# -------------------------------------------------------------
# 2. PRODUCTION: MilesWeb Business SMTP Configuration
# -------------------------------------------------------------
SMTP_HOST=mail.digitalcustard.in
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info@digitalcustard.in
SMTP_PASSWORD=
ADMIN_EMAIL=info@digitalcustard.in
FROM_EMAIL=info@digitalcustard.in
